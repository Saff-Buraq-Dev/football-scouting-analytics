# Copy to .env (gitignored). Local development values only.
POSTGRES_USER=football
POSTGRES_PASSWORD=football_dev
POSTGRES_DB=football
POSTGRES_PORT=5433
DATABASE_URL=postgresql://football:football_dev@localhost:5433/football
# The API reads AUTH_PROVIDER from the process environment (not from this file). For the recruitment board
# locally: AUTH_PROVIDER=dev .venv/bin/uvicorn football_platform.api.app:app --port 8000
